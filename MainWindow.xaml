<Window x:Class="KeyMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="键盘宏" Width="1080" Height="680"
        MinWidth="920" MinHeight="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="StepItemContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C2430"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C2430"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacroItemContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22304A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0E1116" CornerRadius="14" BorderBrush="#2A3444" BorderThickness="1"
            Margin="0,0,2,2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0" Background="#151A22" CornerRadius="14,14,0,0" Padding="18,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <!-- 标题 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Cursor="SizeAll">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="⌨" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="键盘宏" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="运行中" FontSize="12" Foreground="{StaticResource GreenBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 窗口按钮 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="BtnMin" Style="{StaticResource IconButton}" Content="─" Click="BtnMin_Click"/>
                        <Button x:Name="BtnClose" Style="{StaticResource IconButton}" Content="✕" Click="BtnClose_Click" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- 全局开关热键 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="全局开关" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="8,0,0,0">
                            <TextBlock x:Name="ToggleKeyText" Text="F8" FontSize="13" FontWeight="SemiBold" MinWidth="34" TextAlignment="Center"/>
                        </Border>
                        <Button x:Name="BtnToggleCapture" Style="{StaticResource GhostButton}" Content="录制" Padding="10,5" Margin="6,0,0,0" Click="BtnToggleCapture_Click"/>
                        <Button x:Name="BtnToggleNow" Style="{StaticResource PrimaryButton}" Content="立即暂停" Padding="12,5" Margin="8,0,0,0" Click="BtnToggleNow_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ 主内容 ============ -->
            <Grid Grid.Row="1" Margin="18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧:宏列表 -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="宏列表" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button x:Name="BtnAddMacro" Style="{StaticResource PrimaryButton}" Content="＋ 新建宏" Padding="12,6" DockPanel.Dock="Right" Click="BtnAddMacro_Click"/>
                        </DockPanel>

                        <ListBox x:Name="MacroList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource MacroItemContainer}"
                                 SelectionChanged="MacroList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ListTitle}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="🗑" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                FontSize="12" Margin="8,0,0,0" Tag="{Binding}" Click="MacroDelete_Click"
                                                ToolTip="删除此宏"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 右侧:宏编辑 -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 名称 + 启用 -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="宏名称" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,4"/>
                                <TextBox x:Name="MacroNameBox" Style="{StaticResource TextBoxStyle}" FontSize="15" FontWeight="SemiBold"
                                         TextChanged="MacroNameBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                <CheckBox x:Name="MacroEnabledCheck" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="True" Checked="MacroEnabledCheck_Changed" Unchecked="MacroEnabledCheck_Changed"/>
                                <TextBlock x:Name="MacroEnabledLabel" Text="启用" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- 触发键 -->
                        <Border Grid.Row="1" Background="#131A24" CornerRadius="10" Padding="14,12" Margin="0,0,0,14"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="触发键" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="修饰键" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <CheckBox x:Name="ModCtrl" Content="Ctrl" Style="{StaticResource ToggleSwitchStyle}" FontSize="12"
                                                  VerticalAlignment="Center" Checked="Modifiers_Changed" Unchecked="Modifiers_Changed"/>
                                        <CheckBox x:Name="ModShift" Content="Shift" Style="{StaticResource ToggleSwitchStyle}" FontSize="12" Margin="12,0,0,0"
                                                  VerticalAlignment="Center" Checked="Modifiers_Changed" Unchecked="Modifiers_Changed"/>
                                        <CheckBox x:Name="ModAlt" Content="Alt" Style="{StaticResource ToggleSwitchStyle}" FontSize="12" Margin="12,0,0,0"
                                                  VerticalAlignment="Center" Checked="Modifiers_Changed" Unchecked="Modifiers_Changed"/>
                                        <CheckBox x:Name="ModWin" Content="Win" Style="{StaticResource ToggleSwitchStyle}" FontSize="12" Margin="12,0,0,0"
                                                  VerticalAlignment="Center" Checked="Modifiers_Changed" Unchecked="Modifiers_Changed"/>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                            Padding="14,7" MinWidth="150">
                                        <TextBlock x:Name="TriggerKeyText" Text="未设置" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnCaptureTrigger" Content="录制触发键" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                            Margin="8,0,0,0" Click="BtnCaptureTrigger_Click"/>
                                    <TextBlock x:Name="CaptureHint" Text="" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 动作序列头部 -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <TextBlock Text="动作序列(按顺序执行)" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 动作列表 -->
                        <ListBox x:Name="StepList" Grid.Row="3" MinHeight="110" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource StepItemContainer}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                                                Background="{Binding StepTypeBg}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StepTypeIcon}" FontSize="12"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,8,0"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="26"
                                                     Style="{StaticResource TextBoxStyle}" FontSize="12" Padding="6,2" TextAlignment="Center"/>
                                            <TextBlock Text="ms" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Content="↑" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12"
                                                    Tag="{Binding}" Click="StepUp_Click"/>
                                            <Button Content="↓" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Margin="2,0,0,0"
                                                    Tag="{Binding}" Click="StepDown_Click"/>
                                            <Button Content="🗑" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Margin="2,0,0,0"
                                                    Tag="{Binding}" Click="StepDelete_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 添加动作 -->
                        <Grid Grid.Row="4" Margin="0,12,0,0">
                            <Border Background="#131A24" CornerRadius="10" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="添加动作" FontSize="13" FontWeight="Bold" Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,10"/>

                                    <ComboBox x:Name="NewStepType" Grid.Row="1" Grid.Column="0" Width="88" SelectedIndex="0"
                                              Style="{StaticResource ComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                              SelectionChanged="NewStepType_SelectionChanged">
                                        <ComboBoxItem Content="按键"/>
                                        <ComboBoxItem Content="延时"/>
                                        <ComboBoxItem Content="文本"/>
                                    </ComboBox>

                                    <Border x:Name="NewKeyPanel" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" CornerRadius="8"
                                            Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="NewKeyText" Text="按键" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="52"/>
                                            <Button x:Name="BtnCaptureStepKey" Content="录制" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11"
                                                    Margin="8,0,0,0" Click="BtnCaptureStepKey_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="NewTextPanel" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed">
                                        <TextBox x:Name="NewTextInput" Style="{StaticResource TextBoxStyle}" Width="180" FontSize="12"
                                                 ToolTip="要输入的文本"/>
                                    </StackPanel>

                                    <TextBox x:Name="NewDelayInput" Grid.Row="1" Grid.Column="2" Style="{StaticResource TextBoxStyle}"
                                             Margin="8,0,0,0" FontSize="12" MaxWidth="120" Text="100"
                                             ToolTip="动作执行后的延时(毫秒)"/>

                                    <Button x:Name="BtnAddStep" Grid.Row="1" Grid.Column="3" Content="＋ 添加" Style="{StaticResource PrimaryButton}"
                                            Padding="14,6" Margin="10,0,0,0" Click="BtnAddStep_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 底部状态栏 ============ -->
            <Border Grid.Row="2" Background="#151A22" CornerRadius="0,0,14,14" Padding="18,9" BorderBrush="#222B38" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoStartCheck" Content="开机自启" Style="{StaticResource ToggleSwitchStyle}" FontSize="12"
                                  Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed"/>
                        <TextBlock Text="排队上限(0=不限)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="16,0,6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="QueueLimitInput" Style="{StaticResource TextBoxStyle}" Width="52" FontSize="12"
                                 Padding="4,3" TextAlignment="Center" VerticalAlignment="Center" Text="0" MaxLength="3"
                                 LostFocus="QueueLimitInput_LostFocus"
                                 ToolTip="连按触发键时,排队中(未开始执行)的宏数量上限;0=不限制,正在执行的宏不计入排队"/>
                        <Button x:Name="BtnApplyQueueLimit" Content="应用" Style="{StaticResource GhostButton}" Padding="10,4"
                                Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Click="BtnApplyQueueLimit_Click"
                                ToolTip="立即生效:按输入值裁剪当前已排队的宏(保留最早排队的 N 个),并作用于之后的新触发"/>
                        <TextBlock Text="关闭窗口将最小化到系统托盘" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="FooterHint" Text="宏已启用 · 触发键在游戏中全局生效" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
